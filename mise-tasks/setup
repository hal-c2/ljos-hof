#!/usr/bin/env bash
#MISE description="First, after cloning, and safe to run again: install Rust (with the targets the tasks build for) and Zig, link or clone Ljós UI at the pinned revision into third_party/, fetch the crates, and say what's missing"
#USAGE flag "--ljos-ui <dir>" help="The Ljós UI checkout to link into third_party/ljos-ui (default: the one there already, else $LJOS_UI_DIR, else a clone of hal-c2/ljos-ui at third_party/ljos-ui.rev)"
#USAGE flag "--no-clone" help="When no Ljós UI checkout is found, fail instead of cloning hal-c2/ljos-ui into third_party/ljos-ui"
set -euo pipefail
did=()
skipped=()
missing=()

mise install --quiet
pinned="${RUSTUP_TOOLCHAIN:-}"
# mise.toml's activate_aggressive puts rustup's pinned toolchain first on
# PATH; a rustc that is still another one means mise isn't driving this
# shell (no mise.toml trust, or no rustup), and every build would differ.
have="$(rustc --version 2>/dev/null | cut -d' ' -f2 || true)"
if [ -z "$pinned" ] || [ "$have" != "$pinned" ]; then
  echo "setup: rustc on PATH is ${have:-missing} ($(command -v rustc || echo none)), not mise.toml's ${pinned:-pin}." >&2
  echo "  Install rustup (https://rustup.rs) so mise can install Rust ${pinned:-1.98.1}, then run mise run setup again." >&2
  exit 1
fi
did+=("mise install: Rust $pinned and Zig $(zig version), as mise.toml pins them")

# The targets other tasks build for, added to the pinned toolchain only:
# agents (the static hof-agent for Linux machines with no Hof) and
# check-macos. Each is a download of the standard library for it.
command -v rustup >/dev/null || { echo "setup: rustup is not on PATH; install it from https://rustup.rs" >&2; exit 1; }
targets=(x86_64-unknown-linux-musl aarch64-unknown-linux-musl aarch64-apple-darwin)
rustup target add --toolchain "$pinned" "${targets[@]}" >/dev/null 2>&1 ||
  rustup target add --toolchain "$pinned" "${targets[@]}"
did+=("rustup target add ${targets[*]} (to $pinned): for mise run agents and check-macos")

# Ljós UI is a path dependency in third_party/ljos-ui, at the revision
# Cargo.lock was made against (third_party/ljos-ui.rev): its main moves on,
# and a build against a newer one rewrites Cargo.lock. In order: the
# directory named, what is linked or cloned there already, $LJOS_UI_DIR,
# and last a clone of our own.
ljos_ok() { [ -f "$1/crates/ljos/Cargo.toml" ]; }
link="third_party/ljos-ui"
rev="$(cat third_party/ljos-ui.rev)"
dir="${usage_ljos_ui:-}"
if [ -n "$dir" ]; then
  ljos_ok "$dir" || { echo "no Ljós UI checkout at $dir" >&2; exit 1; }
  [ -L "$link" ] || [ ! -e "$link" ] || { echo "$link is a directory, not a link; move it away to link $dir" >&2; exit 1; }
  ln -sfn "$(cd "$dir" && pwd)" "$link"
  did+=("linked $link -> $dir")
elif ljos_ok "$link"; then
  did+=("kept $link ($(readlink "$link" || echo "a clone"))")
elif [ -n "${LJOS_UI_DIR:-}" ] && ljos_ok "$LJOS_UI_DIR"; then
  # A relative link would resolve from third_party/, not from here.
  ln -sfn "$(cd "$LJOS_UI_DIR" && pwd)" "$link"
  did+=("linked $link -> $LJOS_UI_DIR")
elif [ "${usage_no_clone:-false}" = true ]; then
  echo "no Ljós UI checkout at ${LJOS_UI_DIR:-$link}; pass --ljos-ui DIR or set LJOS_UI_DIR" >&2
  exit 1
else
  # Only the pinned commit: its submodules are its corpus and prior art,
  # and Hof builds without them.
  rm -f "$link"
  git init --quiet "$link"
  git -C "$link" remote add origin https://github.com/hal-c2/ljos-ui
  git -C "$link" fetch --quiet --depth 1 origin "$rev"
  git -C "$link" checkout --quiet FETCH_HEAD
  did+=("cloned hal-c2/ljos-ui at $rev into $link${LJOS_UI_DIR:+ (no checkout at $LJOS_UI_DIR)}; --ljos-ui DIR links one instead")
fi

# Our own clone follows the pin; a linked checkout is yours, so it is only
# compared (and mise run check fails on a difference, as Cargo.lock would).
at="$(git -C "$link" rev-parse HEAD 2>/dev/null || echo unknown)"
locked=(--locked)
if [ "$at" != "$rev" ]; then
  if [ ! -L "$link" ] && [ -z "$(git -C "$link" status --porcelain)" ]; then
    git -C "$link" fetch --quiet --depth 1 origin "$rev"
    git -C "$link" checkout --quiet "$rev"
    did+=("moved $link from $at to the pinned $rev")
  else
    locked=()
    skipped+=("$link is at $at, not the pinned $rev (third_party/ljos-ui.rev): Cargo.lock may change and mise run check fails until it matches; git -C $link checkout $rev")
  fi
fi

# Everything cargo needs from the network, once: libghostty-rs from git
# and the crates. After this, builds work offline too. (Ghostty's own
# source is fetched by libghostty-vt-sys's build script, at the first build.)
# bash 3.2 (macOS) calls an empty array unbound under set -u.
cargo fetch --quiet ${locked[@]+"${locked[@]}"}
did+=("cargo fetch")

# What Hof needs from the system, which setup can't install.
case "$(uname -s)" in
  Linux)
    command -v cc >/dev/null || missing+=("a C compiler (cc), for the -sys crates: gcc or clang")
    if command -v pkg-config >/dev/null; then
      pkg-config --exists alsa || missing+=("ALSA headers, for remote panes' sound (cpal): libasound2-dev / alsa-lib-devel / alsa-lib")
      pkg-config --exists fontconfig || missing+=("fontconfig, to find fonts: libfontconfig-dev / fontconfig-devel / fontconfig")
      pkg-config --exists xkbcommon || skipped+=("xkbcommon not found: keyboard layouts need libxkbcommon at run time")
      pkg-config --exists wayland-client || skipped+=("wayland-client not found: Hof will open X11 windows only")
    else
      missing+=("pkg-config, which the -sys crates use to find ALSA and fontconfig")
    fi
    ;;
  Darwin)
    xcode-select -p >/dev/null 2>&1 || missing+=("the Xcode command line tools: xcode-select --install")
    ;;
esac
command -v docker >/dev/null || skipped+=("docker not found: mise run remote-test needs it")

echo
echo "setup did:"
printf '  - %s\n' "${did[@]}"
if [ ${#skipped[@]} -gt 0 ]; then
  echo "skipped, and what it means:"
  printf '  - %s\n' "${skipped[@]}"
fi
if [ ${#missing[@]} -gt 0 ]; then
  echo "missing, and the build needs it (install it with your system's package manager):"
  printf '  - %s\n' "${missing[@]}"
  exit 1
fi
echo "next: mise run dev"
