#!/usr/bin/env bash
#MISE description="Regenerate the types the QML is compiled against, after changing a Rust type QML sees; --check only says whether they are current"
#USAGE flag "--check" help="Write nothing; fail when the committed types differ from the Rust types"
set -euo pipefail
# The test compares the committed type dump with the Rust types; with
# LJOS_TYPES=write it rewrites the dump instead.
if [ "${usage_check:-false}" = true ]; then
  cargo test --locked -p hof --test types
else
  LJOS_TYPES="write" cargo test --locked -p hof --test types
  git status --short -- crates/hof
fi
