#!/usr/bin/env bash
#MISE description="Install hof on your PATH with cargo install (~/.cargo/bin unless --root), and with --agents the hof-agent builds for remote machines"
#USAGE flag "--root <dir>" help="Install under DIR/bin instead of $CARGO_INSTALL_ROOT, else $CARGO_HOME, else ~/.cargo"
#USAGE flag "--agents" help="Also build the static hof-agent for x86_64 and aarch64 Linux, into ROOT/lib/hof where hof looks for it"
#USAGE flag "--dry-run" help="Say where hof (and the agents) would go and what would be run, and change nothing"
set -euo pipefail
# The root is chosen here and handed to cargo, rather than read back from
# what cargo prints, so the agents are put beside hof whatever cargo's
# wording. Cargo's install.root setting is not consulted: pass --root.
root="${usage_root:-${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}}"
args=(--locked --path crates/hof --root "$root")
if [ "${usage_dry_run:-false}" = true ]; then
  echo "install --dry-run: would run: cargo install ${args[*]}"
  echo "  hof would go to $root/bin/hof"
  if [ "${usage_agents:-false}" = true ]; then
    echo "  then: mise run agents, and copy hof-agent-x86_64-linux and hof-agent-aarch64-linux to $root/lib/hof/"
  fi
  [ -f crates/hof/Cargo.toml ] || { echo "install: no crates/hof/Cargo.toml here" >&2; exit 1; }
  exit 0
fi
# Before minutes of cargo install: agents fails at once on a missing target.
if [ "${usage_agents:-false}" = true ]; then
  for arch in x86_64 aarch64; do
    rustup target list --installed | grep -qx "$arch-unknown-linux-musl" ||
      { echo "install: --agents needs Rust's $arch-unknown-linux-musl target: run mise run setup" >&2; exit 1; }
  done
fi
cargo install "${args[@]}"
[ -x "$root/bin/hof" ] || { echo "install: cargo install finished, but there is no $root/bin/hof" >&2; exit 1; }
echo "hof in $root/bin"
if [ "${usage_agents:-false}" = true ]; then
  mise run agents
  # Where cargo builds: CARGO_TARGET_DIR, a build.target-dir in a
  # .cargo/config.toml, or target/.
  target_dir="$(cargo metadata --locked --format-version 1 --no-deps | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')"
  mkdir -p "$root/lib/hof"
  for arch in x86_64 aarch64; do
    cp "$target_dir/$arch-unknown-linux-musl/agent/hof-agent" "$root/lib/hof/hof-agent-$arch-linux"
  done
  echo "agents in $root/lib/hof"
fi
case ":$PATH:" in
  *":$root/bin:"*) ;;
  *) echo "note: $root/bin is not on your PATH" ;;
esac
