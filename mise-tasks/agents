#!/usr/bin/env bash
#MISE description="Build the static hof-agent Hof copies to Linux machines that have no Hof: x86_64 and aarch64 (musl), or the one --only names"
#USAGE flag "--only <arch>" help="Build for this one only: x86_64 or aarch64" {
#USAGE   choices "x86_64" "aarch64"
#USAGE }
set -euo pipefail
out="${CARGO_TARGET_DIR:-target}"
arches=(x86_64 aarch64)
[ -z "${usage_only:-}" ] || arches=("$usage_only")
# Every target first, so a missing one fails before minutes of building
# the others; a partial set would leave Hof unable to reach some machines.
command -v rustup >/dev/null || { echo "agents: rustup is not on PATH; install it from https://rustup.rs" >&2; exit 1; }
installed="$(rustup target list --installed)"
for arch in "${arches[@]}"; do
  target="$arch-unknown-linux-musl"
  printf '%s\n' "$installed" | grep -qx "$target" ||
    { echo "agents: Rust's $target target is not installed: run mise run setup (or rustup target add $target), or pass --only for the others" >&2; exit 1; }
done
# Ghostty's source from an earlier build, so a new target needn't fetch it.
if [ -z "${GHOSTTY_SOURCE_DIR:-}" ]; then
  for src in "$out"/*/build/libghostty-vt-sys-*/out/ghostty-src "$out"/*/*/build/libghostty-vt-sys-*/out/ghostty-src; do
    if [ -f "$src/build.zig" ]; then GHOSTTY_SOURCE_DIR="$(cd "$src" && pwd)"; export GHOSTTY_SOURCE_DIR; break; fi
  done
fi
for arch in "${arches[@]}"; do
  target="$arch-unknown-linux-musl"
  cargo build --locked --profile agent -p hof_agent --bin hof-agent --target "$target"
  # Beside Hof's own program, where it looks for them.
  for dir in "$out/debug" "$out/release"; do
    mkdir -p "$dir"
    cp "$out/$target/agent/hof-agent" "$dir/hof-agent-$arch-linux"
  done
  echo "built $out/release/hof-agent-$arch-linux"
done
