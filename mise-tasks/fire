#!/usr/bin/env bash
#MISE description="Stress test: a fire, parsed headless, painted offscreen, then drawn in this terminal (fire 10)"
#USAGE arg "[seconds]" default="5" help="How long the last part, drawn in this terminal, lasts"
set -euo pipefail
out="${CARGO_TARGET_DIR:-target}/release/examples"
cargo build --locked --release -p hof_vt --example fire -p hof_qml --example paint_fire
echo "== the parser and the grid"
"$out/fire" headless
echo "== painted"
"$out/paint_fire"
# Last, as it takes the screen.
if [ -t 1 ]; then
  "$out/fire" "${usage_seconds:-5}"
else
  echo "== drawn in this terminal: skipped, as stdout is not a terminal"
fi
