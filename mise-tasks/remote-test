#!/usr/bin/env bash
#MISE description="Copy hof-agent to a machine with no Hof, in a container reached over ssh, and run a pane there (remote-test alpine:3.22)"
#USAGE arg "[base_image]" default="debian:bookworm-slim" help="The Docker image the container starts from"
set -euo pipefail
base="${usage_base_image:-debian:bookworm-slim}"
for tool in docker ssh ssh-keygen; do
  command -v "$tool" >/dev/null || { echo "remote-test: $tool is not on PATH; it needs Docker and OpenSSH's client" >&2; exit 1; }
done
docker info >/dev/null 2>&1 || { echo "remote-test: docker is installed but its daemon doesn't answer (is it running, and may you use it?)" >&2; exit 1; }
# Where cargo builds: CARGO_TARGET_DIR, a build.target-dir in a
# .cargo/config.toml, or target/.
target_dir="$(cargo metadata --locked --format-version 1 --no-deps | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')"
release="$target_dir/release"
# The container runs on the Docker daemon's architecture (arm64 on an Apple
# silicon Mac); its agent is all this needs.
docker_arch="$(docker info --format '{{.Architecture}}')"
case "$docker_arch" in
  x86_64 | amd64) arch=x86_64 ;;
  aarch64 | arm64) arch=aarch64 ;;
  *) echo "remote-test: Hof has no agent for Docker's architecture, $docker_arch" >&2; exit 1 ;;
esac
# Every time: the test copies whatever agent is there, and a stale one
# would pass for the code as it is. Cargo rebuilds only what changed.
mise run agents --only "$arch"
work="$(mktemp -d "${TMPDIR:-/tmp}/hof-remote-test.XXXXXX")"
name="hof-remote-test-$$"
cleanup() {
  docker rm -f "$name" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
ssh-keygen -q -t ed25519 -N "" -f "$work/key"
cp tests/remote/Dockerfile "$work/"
image="hof-remote-test:$(echo "$base" | tr -c 'a-zA-Z0-9.\n' '-')"
docker build -q --build-arg "BASE=$base" -t "$image" "$work" >/dev/null
docker run -d --name "$name" -p 127.0.0.1::22 "$image" >/dev/null
port="$(docker port "$name" 22/tcp | head -1 | sed 's/.*://')"
ssh="ssh -T -p $port -i $work/key -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR me@127.0.0.1"
up=
for _ in $(seq 50); do
  if $ssh true 2>/dev/null; then up=1; break; fi
  sleep 0.2
done
[ -n "$up" ] || { echo "remote-test: the container's sshd never answered on port $port" >&2; exit 1; }
echo "== $base on port $port, no Hof there: $($ssh 'command -v hof || echo none')"
HOF_TEST_SSH="$ssh" HOF_AGENT_DIR="$(cd "$release" && pwd)" \
  cargo test --locked -p hof --test bootstrap -- --ignored --nocapture
echo "== what Hof left there"
$ssh 'ls -la ~/.local/share/hof/*/ ~/.local/bin/'
